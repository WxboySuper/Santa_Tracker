{
  "name": "@santa-tracker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js public site, admin studio, APIs, and jobs — composition root.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --dir ../.. santa:publish && next build",
    "build:vinext": "pnpm --dir ../.. santa:publish && VINEXT_BUILD=1 vite build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "dev:vinext": "vite dev --port 3001",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@santa-tracker/activity-sdk": "workspace:*",
    "@santa-tracker/config": "workspace:*",
    "@santa-tracker/contracts": "workspace:*",
    "@santa-tracker/database": "workspace:*",
    "@santa-tracker/localization": "workspace:*",
    "@santa-tracker/route-engine": "workspace:*",
    "@santa-tracker/ui": "workspace:*",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.2",
    "@vinext/cloudflare": "latest"
  },
  "devDependencies": {
    "@santa-tracker/test-fixtures": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "postcss": "^8.5.6",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vinext": "^1.0.1",
    "vite": "8.3.0",
    "vitest": "5.0.2",
    "wrangler": "^4.147.0",
    "@cloudflare/vite-plugin": "beta",
    "cf": "latest"
  }
}
