# Santa Tracker — Next.js Environment

# Required
ADMIN_PASSWORD=your-secure-admin-password-here
SECRET_KEY=your-secret-key-here-change-in-production
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Feature flags
ADVENT_ENABLED=False

# Optional overrides
# SANTA_ROUTE_PATH=/srv/santa-tracker/data/santa_route.json
# ADVENT_CALENDAR_PATH=/srv/santa-tracker/data/advent_calendar.json

# Logging
LOG_LEVEL=INFO
JSON_LOGS=False

# Next
# NODE_ENV=production
# PORT=3000
