{
  "name": "@santa-tracker/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, repositories, transactions — owns PostgreSQL.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@santa-tracker/config": "workspace:*",
    "@santa-tracker/contracts": "workspace:*",
    "drizzle-orm": "^0.44.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

