{
  "name": "@santa-tracker/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared accessible components and design tokens — no data fetching, no DB.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./components/button": "./src/components/Button.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir ../../storybook-static",
    "storybook:serve": "http-server ../../storybook-static -p 6006",
    "storybook:test": "vitest --config vitest.config.ts --project=storybook && node scripts/storybook-screenshots.mjs",
    "storybook:run": "vitest --config vitest.config.ts --project=storybook",
    "storybook:screenshots": "node scripts/storybook-screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.2.5",
    "axe-playwright": "2.2.2",
    "@vitest/browser-playwright": "4.1.11",
    "http-server": "14.1.1",
    "playwright": "1.62.1",
    "storybook": "10.5.10",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  }
}
