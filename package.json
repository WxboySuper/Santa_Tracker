  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "node scripts/check-test-types.mjs",
    "docs:inventory": "node scripts/generate-repository-inventory.mjs",
    "docs:site": "node scripts/build-local-docs.mjs",
    "test": "jest",
    "test:firestore-rules": "pnpm exec firebase emulators:exec --only firestore --project gfc-rules-test \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "changelog:consolidate-beta": "node scripts/consolidate-beta-changelog.mjs",
    "validate:feature-exposure": "node scripts/validate-feature-exposure.mjs",
    "exposure:report": "node scripts/generate-exposure-report.mjs",
    "test:exposure": "node scripts/run-exposure-suite.mjs",
    "exposure:diagnostics": "node scripts/generate-exposure-diagnostics.mjs",
    "branches:report": "cross-env DRY_RUN=1 node scripts/generate-stale-branch-report.mjs",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "e2e/**/*.ts",
          "e2e/**/*.tsx"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off",
          "testing-library/no-conditional-expect": "off",
          "jest/expect-expect": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
