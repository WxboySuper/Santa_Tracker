  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:test": "node scripts/check-test-types.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:inventory": "node scripts/generate-repository-inventory.mjs",
    "docs:site": "node scripts/build-local-docs.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/check-third-party-licenses.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "perf": "cross-env GFC_PERF=1 jest --runInBand src/performance",
    "test:firestore-rules": "pnpm exec firebase emulators:exec --only firestore --project gfc-rules-test \"node --test tests/firestore.rules.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "changelog:consolidate-beta": "node scripts/consolidate-beta-changelog.mjs",
    "validate:feature-exposure": "node scripts/validate-feature-exposure.mjs",
    "exposure:report": "node scripts/generate-exposure-report.mjs",
    "test:exposure": "node scripts/run-exposure-suite.mjs",
    "exposure:diagnostics": "node scripts/generate-exposure-diagnostics.mjs",
    "branches:report": "cross-env DRY_RUN=1 node scripts/generate-stale-branch-report.mjs",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
