{
  "name": "santa-tracker-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Santa Tracker — Next.js pnpm workspace (Christmas 2026 reinvention)",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.26",
      "undici": "7.29.1",
      "sharp": "0.35.3",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @santa-tracker/web dev",
    "bootstrap": "node tools/bootstrap.mjs",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint . --max-warnings=0",
    "lint:legacy:js": "eslint src --ext .js",
    "lint:html": "htmlhint \"apps/web/**/*.html\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "santa:publish": "node tools/santa-publish.mjs",
    "santa:publish:remote": "node tools/santa-publish.mjs --remote"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "htmlhint": "^1.1.4",
    "prettier": "^3.9.10",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "moment": "^2.31.0"
  }
}
