{
  "name": "santa-tracker-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Santa Tracker — Next.js pnpm workspace (Christmas 2026 reinvention)",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.26",
      "undici": "7.30.1",
      "sharp": "0.35.5",
      "fast-uri": "3.1.9",
      "follow-redirects": "1.16.2",
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "qs@>=2.2.5 <6.16.1": "6.16.1",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "glob@>=9.0.0 <14.0.2": "14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @santa-tracker/web dev",
    "bootstrap": "node tools/bootstrap.mjs",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:js": "eslint . --max-warnings=0",
    "lint:legacy:js": "eslint src --ext .js",
    "lint:html": "htmlhint \"apps/web/**/*.html\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "rehearsal": "tsx tools/rehearsal/rehearse.ts",
    "load:local": "node tools/rehearsal/load.mjs",
    "santa:publish": "node tools/santa-publish.mjs",
    "santa:publish:remote": "node tools/santa-publish.mjs --remote",
    "route:generate": "tsx tools/route-generator/generate.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@photostructure/tz-lookup": "11.8.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "htmlhint": "^1.1.4",
    "prettier": "^3.9.10",
    "shapefile": "0.6.6",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^39.0.1",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "moment": "^2.31.0"
  }
}
